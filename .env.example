# Listenly Web — environment configuration
#
# Base URL of the Listenly API Gateway (HTTP). The app appends /api/v1.
# Example (local dev gateway): http://localhost:8080
VITE_API_BASE_URL=http://localhost:8080

# Optional: explicit WebSocket base. When omitted it is derived from
# VITE_API_BASE_URL (http -> ws, https -> wss). The app appends /api/v1.
# VITE_WS_BASE_URL=ws://localhost:8080
